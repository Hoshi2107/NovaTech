@{
    ViewData["Title"] = "Stream Live Viewer";
}

<div id="liveviewer-app" class="w-100 min-vh-100 bg-stream-black position-relative" v-cloak>
    <!-- BACK BUTTON FOR DEV/TEST -->
    <div class="position-absolute top-0 start-0 m-3" style="z-index: 1050;">
        <a href="/" class="btn btn-sm btn-stream-dark text-white bg-opacity-75 d-flex align-items-center gap-2 px-3 py-2 border border-secondary border-opacity-25 backdrop-blur">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Seller Center</span>
        </a>
    </div>

    <!-- MAIN RESPONSIVE CONTAINER -->
    <div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center p-0 p-lg-4">
        <!-- WRAPPER THAT SWITCHES LAYOUT ON PC/MOBILE -->
        <div class="viewer-main-wrapper w-100 shadow-2xl overflow-hidden d-flex flex-column flex-lg-row">
            
            <!-- LEFT PANEL: THE LIVE VIDEO (9:16 aspect ratio simulation on PC, full screen on mobile) -->
            <div class="video-panel position-relative flex-grow-1 d-flex align-items-center justify-content-center">
                
                <!-- Video Aspect Ratio Box -->
                <div class="video-aspect-container w-100 h-100">
                    <div class="video-backdrop-container">
                        <!-- Live Camera Feed -->
                        <img :src="currentFrame" class="viewer-webcam-video" v-if="isLive && currentFrame" />
                        
                        <!-- Pulse neon overlay when not live or camera is off -->
                        <div class="neon-stream-placeholder d-flex flex-column align-items-center justify-content-center text-center p-4" v-else>
                            <div class="pulse-ring mb-4" :class="{ 'active': isLive }">
                                <i class="fa-solid fa-satellite-dish text-white fs-1"></i>
                            </div>
                            <h5 class="fw-bold text-white mb-2 tracking-wide">
                                ${isLive ? 'ĐANG PHÁT TRỰC TIẾP' : 'LIVESTREAM CHƯA BẮT ĐẦU'}
                            </h5>
                            <p class="text-muted text-xs px-4 max-w-sm">
                                ${isLive ? 'Chào mừng bạn đến với phiên Live của NovaTech Shop! Săn ngay các deal cực hot phía dưới nhé!' : 'Vui lòng đợi Host bắt đầu phát sóng để xem các mặt hàng.'}
                            </p>
                            
                            <!-- Visualizer wave bars when live but no frame -->
                            <div class="d-flex gap-1 align-items-end mt-4" style="height: 30px;" v-if="isLive">
                                <div class="bar bg-stream-teal"></div>
                                <div class="bar bg-stream-red"></div>
                                <div class="bar bg-stream-teal"></div>
                                <div class="bar bg-stream-red"></div>
                                <div class="bar bg-stream-teal"></div>
                            </div>
                        </div>
                    </div>

                    <!-- FLOATING HEARTS CONTAINER -->
                    <div class="hearts-container" ref="heartsContainer"></div>

                    <!-- PERSONAL LIKE PROGRESS BAR (Top-left) -->
                    <div class="personal-like-progress-container position-absolute start-0 m-3" :class="{ 'scale-up': isProgressPulsing }" v-if="isLive" style="top: 70px; z-index: 100; pointer-events: auto; width: 170px;">
                        <div class="d-flex align-items-center justify-content-between text-white text-3xs mb-1 fw-bold">
                            <span><i class="fa-solid fa-heart text-stream-red me-1 animate-pulse"></i>Mục tiêu tim</span>
                            <span class="text-stream-teal">${personalLikes}/100</span>
                        </div>
                        <div class="progress" style="height: 6px; background-color: rgba(255, 255, 255, 0.15); border-radius: 3px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.05);">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-stream-red" role="progressbar" :style="{ width: personalLikes + '%' }" :aria-valuenow="personalLikes" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <!-- Stream LIVE HUD OVERLAY (Visible on both mobile/desktop for profile, stats) -->
                    <div class="live-hud d-flex flex-column justify-content-between p-3" v-if="isLive">
                        <!-- TOP HUD: Host profile, viewers count -->
                        <div class="d-flex justify-content-between align-items-start w-100">
                            <!-- Host Badge -->
                            <div class="d-flex align-items-center bg-dark bg-opacity-65 rounded-pill p-1 pe-3 border border-secondary border-opacity-10 backdrop-blur">
                                <div class="host-avatar bg-stream-teal text-dark fw-bold rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                    NT
                                </div>
                                <div>
                                    <h6 class="mb-0 text-white fw-bold text-xs" style="line-height: 1.1;">NovaTech Shop</h6>
                                    <small class="text-stream-teal text-2xs" style="font-size: 0.65rem;">@@novatech.shop</small>
                                </div>
                                <button class="btn btn-stream-primary p-0 rounded-circle ms-2 d-flex align-items-center justify-content-center animate-pulse" style="width: 18px; height: 18px; font-size: 0.6rem;">
                                    <i class="fa-solid fa-plus text-white"></i>
                                </button>
                            </div>
                            
                            <!-- Live status and Viewer counts -->
                            <div class="d-flex align-items-center gap-2 bg-dark bg-opacity-65 rounded-pill px-2 py-1 border border-secondary border-opacity-10 backdrop-blur">
                                <span class="badge bg-stream-red px-2 py-1 text-2xs me-1 animate-pulse">LIVE</span>
                                <div class="viewer-bubbles d-flex align-items-center me-1 d-none d-sm-flex">
                                    <div class="viewer-bubble bg-purple">A</div>
                                    <div class="viewer-bubble bg-danger">B</div>
                                    <div class="viewer-bubble bg-warning">C</div>
                                </div>
                                <span class="text-white text-xs fw-bold ms-1"><i class="fa-regular fa-eye me-1 text-stream-teal"></i>${viewerCount}</span>
                                <button class="btn btn-sm p-0 border-0 bg-transparent ms-1" @@click="toggleMute" :title="isMuted ? 'Bật âm thanh' : 'Tắt âm thanh'" style="width:28px;height:28px;">
                                    <i class="fa-solid text-white" :class="isMuted ? 'fa-volume-xmark text-danger' : 'fa-volume-high text-stream-teal'"></i>
                                </button>
                            </div>
                        </div>

                        <!-- MIDDLE: Spaced out for streaming screen -->
                        <div class="flex-grow-1"></div>

                        <!-- BOTTOM HUD OVERLAYS (Only visible on Mobile view <= 991px) -->
                        <div class="mobile-hud-bottom w-100 d-flex flex-column gap-2 d-lg-none">
                            <!-- MOBILE LIKES ANNOUNCEMENT BANNER -->
                            <div class="announcement-banner text-white text-2xs text-center px-2 py-2" :class="{ hiding: isAnnouncementHiding }" v-if="showAnnouncement" style="margin-bottom: 2px;">
                                <span class="d-flex align-items-center justify-content-center gap-1">
                                    <i class="fa-solid fa-crown text-warning"></i>
                                    <strong>${announcementName}</strong> đã like 100 lần cho phiên live này!
                                    <i class="fa-solid fa-heart ms-1" style="color:#FF6B00;"></i>
                                </span>
                            </div>
                            
                            <!-- MOBILE CHAT BOX -->
                            <div class="live-chat-box" ref="chatBoxMobile">
                                <div v-for="(chat, index) in chats" :key="index" class="chat-message animate-fade-in">
                                    <span class="chat-username" :class="chat.color">${chat.username}:</span>
                                    <span class="chat-text text-white">${chat.text}</span>
                                </div>
                            </div>

                            <!-- MOBILE PINNED PRODUCT CARD -->
                            <div class="pinned-product-card d-flex align-items-center p-2 rounded-3 animate-fade-in" v-if="pinnedProduct">
                                <div class="pinned-badge">Đang Ghim</div>
                                <img :src="pinnedProduct.imageUrl || 'https://via.placeholder.com/80'" class="product-img bg-secondary rounded" alt="Pinned Product">
                                <div class="product-details ms-2 flex-grow-1">
                                    <h6 class="product-title mb-0 text-white text-xs text-truncate">${pinnedProduct.name}</h6>
                                    <div class="d-flex align-items-center justify-content-between mt-1">
                                        <span class="product-price text-stream-teal fw-bold text-xs">${formatCurrency(pinnedProduct.price)}</span>
                                        <span class="product-stock text-muted text-3xs" style="font-size: 0.65rem;">Kho Live: ${pinnedProduct.stock}</span>
                                    </div>
                                </div>
                                <button class="btn btn-stream-primary btn-sm px-3 py-1 ms-2 text-xs" @@click="openBuyModal(pinnedProduct)">
                                    Mua Ngay
                                </button>
                            </div>

                            <!-- MOBILE ACTION FOOTER PANEL -->
                            <div class="d-flex align-items-center justify-content-between mt-1">
                                <!-- Shopping bag -->
                                <div class="shopping-bag-icon position-relative cursor-pointer" @@click="toggleShoppingList">
                                    <i class="fa-solid fa-bag-shopping text-white fs-4 bg-dark bg-opacity-65 p-2 rounded-circle border border-secondary border-opacity-10"></i>
                                    <span class="badge bg-stream-red position-absolute top-0 start-100 translate-middle rounded-pill" style="font-size: 0.6rem;">
                                        ${liveProducts.length}
                                    </span>
                                </div>

                                <!-- Comment Input Form -->
                                <form @@submit.prevent="sendUserComment" class="flex-grow-1 mx-2">
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control form-control-stream bg-opacity-65 border-0 text-white text-xs rounded-pill px-3 py-2" v-model="myComment" placeholder="Bình luận gì đó..." style="background-color: rgba(0,0,0,0.65);">
                                    </div>
                                </form>
                                
                                <!-- Heart Like Button -->
                                <div class="d-flex align-items-center gap-1">
                                    <button class="btn btn-dark bg-opacity-65 rounded-circle p-2 text-white border border-secondary border-opacity-10 position-relative" @@click="likeLiveStream">
                                        <i class="fa-solid fa-heart text-stream-red fs-4 animate-pulse"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- MOBILE SLIDE-UP OVERLAY SHOPPING LIST -->
                    <div class="shopping-list-overlay p-3 text-light d-lg-none" v-if="showShoppingList && isLive">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0 text-white"><i class="fa-solid fa-store text-stream-teal me-2"></i>Sản phẩm đang bán (${liveProducts.length})</h6>
                            <i class="fa-solid fa-xmark cursor-pointer fs-5" @@click="toggleShoppingList"></i>
                        </div>
                        
                        <div class="shopping-items-wrapper">
                            <div v-if="liveProducts.length === 0" class="text-center py-5">
                                <p class="text-muted text-xs">Chưa có sản phẩm nào được đưa lên livestream.</p>
                            </div>
                            
                            <div class="shopping-item d-flex align-items-center p-2 mb-2 rounded bg-dark bg-opacity-50 border border-secondary border-opacity-10" v-for="p in liveProducts" :key="p.productId">
                                <img :src="p.imageUrl || 'https://via.placeholder.com/80'" class="rounded bg-secondary" width="55" height="55" style="object-fit: cover;">
                                <div class="ms-2 flex-grow-1">
                                    <div class="fw-bold text-white text-xs text-truncate" style="max-width: 150px;">${p.name}</div>
                                    <div class="d-flex align-items-center justify-content-between mt-1">
                                        <span class="text-stream-teal fw-bold text-xs">${formatCurrency(p.price)}</span>
                                        <span class="text-muted text-3xs" style="font-size: 0.65rem;">Còn: ${p.stock}</span>
                                    </div>
                                </div>
                                <button class="btn btn-stream-primary btn-sm px-2 py-1 text-2xs ms-2" @@click="openBuyModal(p)" :disabled="p.stock <= 0">
                                    Mua
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT PANEL: DESKTOP SIDEBAR (Visible only on width >= 992px for PC layout) -->
            <div class="desktop-sidebar d-none d-lg-flex flex-column bg-stream-card border-start border-secondary border-opacity-25" style="width: 400px; min-width: 400px; max-width: 400px;">
                <!-- Pinned Product Section (Feature card) -->
                <div class="p-3 border-bottom border-secondary border-opacity-25 bg-stream-dark bg-opacity-40" v-if="pinnedProduct && isLive">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-stream-red text-white py-1 px-2 text-2xs fw-bold animate-pulse"><i class="fa-solid fa-thumbtack me-1"></i>SẢN PHẨM ĐANG GHIM</span>
                        <span class="text-3xs text-muted">Deal hot nhất phiên Live</span>
                    </div>
                    <div class="desktop-pinned-card d-flex align-items-center p-2 rounded-3 border border-stream-teal border-opacity-35 bg-stream-black">
                        <img :src="pinnedProduct.imageUrl || 'https://via.placeholder.com/80'" class="rounded bg-secondary" width="70" height="70" style="object-fit: cover;">
                        <div class="ms-3 flex-grow-1 min-width-0">
                            <h6 class="product-title mb-1 text-white text-xs fw-bold text-truncate" style="max-width: 170px;">${pinnedProduct.name}</h6>
                            <div class="d-flex align-items-center justify-content-between">
                                <span class="product-price text-stream-teal fw-bold text-xs">${formatCurrency(pinnedProduct.price)}</span>
                                <span class="badge bg-dark text-muted text-3xs border border-secondary border-opacity-25">Còn: ${pinnedProduct.stock}</span>
                            </div>
                        </div>
                        <button class="btn btn-stream-primary btn-sm px-3 py-2 ms-2 text-xs" @@click="openBuyModal(pinnedProduct)">
                            Mua Ngay
                        </button>
                    </div>
                </div>

                <!-- CHAT SECTION -->
                <div class="desktop-chat-section d-flex flex-column border-bottom border-secondary border-opacity-25" style="height: 320px;">
                    <div class="px-3 py-2 bg-stream-black bg-opacity-30 d-flex justify-content-between align-items-center">
                        <span class="fw-bold text-white text-xs"><i class="fa-regular fa-comments text-stream-red me-2"></i>Trò chuyện trực tiếp</span>
                        <span class="text-muted text-3xs d-flex align-items-center"><i class="fa-solid fa-heart text-stream-red me-1"></i>${likesCount} thích</span>
                    </div>
                    
                    <!-- DESKTOP LIKES ANNOUNCEMENT BANNER -->
                    <div class="announcement-banner text-white text-xs px-3 py-2" :class="{ hiding: isAnnouncementHiding }" v-if="showAnnouncement">
                        <span class="d-flex align-items-center justify-content-center gap-1">
                            <i class="fa-solid fa-crown text-warning animate-pulse"></i>
                            <strong>${announcementName}</strong> đã like 100 lần cho phiên live này!
                            <i class="fa-solid fa-heart ms-1" style="color:#FF6B00;"></i>
                        </span>
                    </div>
                    
                    <!-- Chat Messages List -->
                    <div class="live-chat-box flex-grow-1 p-3 overflow-y-auto" ref="chatBoxDesktop">
                        <div v-for="(chat, index) in chats" :key="index" class="chat-message animate-fade-in mb-2 bg-stream-dark bg-opacity-70 border border-secondary border-opacity-5">
                            <span class="chat-username" :class="chat.color">${chat.username}:</span>
                            <span class="chat-text text-white">${chat.text}</span>
                        </div>
                    </div>

                    <!-- Chat Input form -->
                    <div class="p-3 bg-stream-black bg-opacity-40">
                        <form @@submit.prevent="sendUserComment">
                            <div class="input-group">
                                <input type="text" class="form-control form-control-stream bg-stream-black text-xs py-2 px-3 border-secondary border-opacity-25" v-model="myComment" placeholder="Gửi bình luận...">
                                <button class="btn btn-stream-primary px-3 text-xs" type="submit">
                                    <i class="fa-solid fa-paper-plane"></i>
                                </button>
                                <button class="btn btn-stream-dark px-3 text-stream-red" type="button" @@click="likeLiveStream" title="Thả tim">
                                    <i class="fa-solid fa-heart"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- SHOPPING SECTION -->
                <div class="desktop-shopping-section d-flex flex-column flex-grow-1" style="min-height: 0;">
                    <div class="px-3 py-2 bg-stream-black bg-opacity-30 d-flex justify-content-between align-items-center border-bottom border-secondary border-opacity-10">
                        <span class="fw-bold text-white text-xs"><i class="fa-solid fa-bag-shopping text-stream-teal me-2"></i>Danh sách sản phẩm (${liveProducts.length})</span>
                        <span class="text-3xs text-muted">Bấm mua để đặt đơn</span>
                    </div>

                    <div class="shopping-items-wrapper p-3 flex-grow-1 overflow-y-auto">
                        <div v-if="!isLive" class="text-center py-5">
                            <p class="text-muted text-xs">Phiên Live chưa diễn ra.</p>
                        </div>
                        <div v-else-if="liveProducts.length === 0" class="text-center py-5">
                            <p class="text-muted text-xs"><i class="fa-solid fa-store-slash mb-2 fs-4 opacity-50 d-block"></i>Chưa có sản phẩm nào trong giỏ hàng.</p>
                        </div>
                        <div v-else>
                            <!-- Product Row -->
                            <div class="desktop-shopping-item d-flex align-items-center p-2 mb-2 rounded bg-stream-dark bg-opacity-60 border border-secondary border-opacity-15 hover-neon-border" v-for="(p, index) in liveProducts" :key="p.productId">
                                <div class="position-relative">
                                    <span class="item-number-badge">${index + 1}</span>
                                    <img :src="p.imageUrl || 'https://via.placeholder.com/80'" class="rounded bg-secondary" width="50" height="50" style="object-fit: cover;">
                                </div>
                                <div class="ms-3 flex-grow-1 min-width-0">
                                    <div class="fw-bold text-white text-xs text-truncate" :title="p.name">${p.name}</div>
                                    <div class="d-flex align-items-center justify-content-between mt-1">
                                        <span class="text-stream-teal fw-bold text-xs">${formatCurrency(p.price)}</span>
                                        <span class="text-muted text-3xs">Tồn: <strong>${p.stock}</strong></span>
                                    </div>
                                </div>
                                <div class="ms-2">
                                    <button class="btn btn-stream-primary btn-sm px-3 py-1 text-2xs" @@click="openBuyModal(p)" :disabled="p.stock <= 0">
                                        Mua
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    <!-- Stream-STYLE BOTTOM SHEET BUY PANEL -->
    <transition name="sheet">
        <div class="buy-sheet-overlay" v-if="showBuySheet" @@click.self="closeBuySheet">
            <div class="buy-sheet-panel">
                <!-- Drag handle -->
                <div class="sheet-drag-handle"></div>

                <!-- Product header -->
                <div class="sheet-product-header" v-if="modalProduct">
                    <img :src="(selectedVariant && selectedVariant.imageUrl) ? selectedVariant.imageUrl : (modalProduct.imageUrl || 'https://via.placeholder.com/80')" class="sheet-product-img">
                    <div class="sheet-product-info">
                        <div class="sheet-price">${formatCurrency(selectedVariant ? selectedVariant.price : modalProduct.price)}</div>
                        <div class="sheet-product-name">${modalProduct.name}</div>
                        <div class="sheet-stock">Kho: <strong>${selectedVariant ? selectedVariant.stock : modalProduct.stock}</strong></div>
                    </div>
                    <button class="sheet-close-btn" @@click="closeBuySheet"><i class="fa-solid fa-xmark"></i></button>
                </div>

                <!-- Variant selector (SKU) -->
                <div class="sheet-section" v-if="productVariants.length > 1">
                    <div class="sheet-label">Phân loại hàng</div>
                    <div class="variant-grid">
                        <button
                            v-for="v in productVariants"
                            :key="v.productId"
                            class="variant-chip"
                            :class="{ active: selectedVariant && selectedVariant.productId === v.productId, 'out-of-stock': v.stock <= 0 }"
                            @@click="selectVariant(v)"
                            :disabled="v.stock <= 0">
                            ${v.label}
                        </button>
                    </div>
                </div>

                <!-- Quantity selector -->
                <div class="sheet-section">
                    <div class="sheet-label">Số lượng</div>
                    <div class="qty-row">
                        <button class="qty-btn" @@click="changeQty(-1)" :disabled="buyForm.quantity <= 1"><i class="fa-solid fa-minus"></i></button>
                        <span class="qty-value">${buyForm.quantity}</span>
                        <button class="qty-btn" @@click="changeQty(1)" :disabled="buyForm.quantity >= (selectedVariant ? selectedVariant.stock : (modalProduct ? modalProduct.stock : 99))"><i class="fa-solid fa-plus"></i></button>
                        <span class="qty-total ms-auto">Tổng: <strong class="text-stream-teal">${formatCurrency(calculateModalTotal())}</strong></span>
                    </div>
                </div>

                <!-- CTA -->
                <div class="sheet-cta">
                    <button class="sheet-order-btn" @@click="goToCheckout" :disabled="!selectedVariant && productVariants.length > 1">
                        <i class="fa-solid fa-bolt me-2"></i>Đặt Hàng Ngay
                    </button>
                </div>
            </div>
        </div>
    </transition>
    <audio ref="audioStreamPlayer" playsinline style="display: none;"></audio>
</div>

<style>
    /* Styling for the Livestream Viewer Screen */
    .bg-stream-black {
        background-color: #0b0c10 !important;
    }
    .bg-stream-dark {
        background-color: #12131a !important;
    }
    .bg-stream-card {
        background-color: #161822 !important;
    }
    .text-stream-teal {
        color: #25F4EE !important;
    }
    .text-stream-red {
        color: #FE2C55 !important;
    }

    .backdrop-blur {
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .hover-neon-border {
        transition: all 0.3s ease;
    }
    .hover-neon-border:hover {
        border-color: rgba(37, 244, 238, 0.4) !important;
        box-shadow: 0 0 10px rgba(37, 244, 238, 0.1);
    }

    /* Screen inner frame for both mobile & desktop */
    .viewer-main-wrapper {
        background-color: #000;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    @@media (min-width: 992px) {
        .viewer-main-wrapper {
            height: 760px;
            max-width: 960px;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .video-panel {
            height: 100%;
            background-color: #050508;
        }
        .video-aspect-container {
            height: 100%;
            max-height: 760px;
            aspect-ratio: 9/16;
            margin: 0 auto;
            position: relative;
            background-color: #000;
        }
    }

    @@media (max-width: 991px) {
        .viewer-main-wrapper {
            min-height: 100vh;
            border-radius: 0;
            border: none;
        }
        .video-panel {
            width: 100vw;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1;
        }
        .video-aspect-container {
            width: 100%;
            height: 100%;
            position: relative;
        }
    }

    .video-backdrop-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, #200e1b 0%, #06070a 100%);
        z-index: 1;
        overflow: hidden;
    }

    .viewer-webcam-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .neon-stream-placeholder {
        width: 100%;
        height: 100%;
        background: linear-gradient(135deg, #18081c 0%, #06090e 100%);
        position: relative;
        z-index: 2;
    }

    .pulse-ring {
        width: 80px;
        height: 80px;
        border-radius: 50%;
