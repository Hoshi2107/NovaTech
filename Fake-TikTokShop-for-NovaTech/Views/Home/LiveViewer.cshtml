@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@2.6.14/dist/vue.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>

    <script>
        new Vue({
            el: '#liveviewer-app',
            delimiters: ['${', '}'],
            data: {
                isLive: false,
                viewerCount: 0,
                likesCount: 0,
                currentFrame: null,
                
                liveProducts: [],
                chats: [],
                myComment: '',
                viewerName: '',

                // Shopping bag overlay (mobile)
                showShoppingList: false,

                // Stream buy bottom sheet state
                showBuySheet: false,
                modalProduct: null,
                productVariants: [],
                selectedVariant: null,

                buyForm: {
                    customerName: '',
                    phone: '',
                    address: '',
                    quantity: 1
                },
                submittingOrder: false,

                // Audio playback
                isMuted: false,
                audioContext: null,
                audioQueue: [],
                audioPlaying: false,

                // SignalR
                hubConnection: null,

                // Personal like goal stack
                personalLikes: 0,
                isProgressPulsing: false,
                showAnnouncement: false,
                isAnnouncementHiding: false,
                announcementName: '',
                announcementTimeout: null
            },
            computed: {
                pinnedProduct() {
                    return this.liveProducts.find(p => p.isPinned);
                }
            },
            mounted() {
                // Prompt client for a screen name to chat
                this.viewerName = localStorage.getItem('Stream_viewer_name') || '';
                
                // Load initial data via HTTP
                this.fetchLiveProducts();
                this.pollState(); // One-time initial state load

                // Connect SignalR - replaces all polling intervals!
                this.initSignalR();

                // Auto-resume or create AudioContext on first user interaction
                const resumeHandler = () => {
                    if (!this.audioContext) {
                        this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                    }
                    if (this.audioContext.state === 'suspended') {
                        this.audioContext.resume();
                    }
                    document.removeEventListener('click', resumeHandler);
                    document.removeEventListener('keydown', resumeHandler);
                };
                document.addEventListener('click', resumeHandler);
                document.addEventListener('keydown', resumeHandler);
            },
            beforeDestroy() {
                if (this.hubConnection) {
                    this.hubConnection.stop();
                }
                if (this.audioContext) {
                    this.audioContext.close();
                    this.audioContext = null;
                }
            },
            methods: {
                // ===== SIGNALR CORE =====
                async initSignalR() {
                    try {
                        this.hubConnection = new signalR.HubConnectionBuilder()
                            .withUrl('/hubs/livestream')
                            .withAutomaticReconnect()
                            .build();

                        // Real-time frame receive (replaces 250ms frame polling!)
                        this.hubConnection.on('ReceiveFrame', (frameData) => {
                            this.currentFrame = frameData;
                        });

                        // Real-time like milestone receive
                        this.hubConnection.on('ReceiveMilestone', (username) => {
                            if (username !== this.viewerName) {
                                this.showLocalAnnouncement(username);
                            }
                        });

                        // Real-time floating heart receive
                        this.hubConnection.on('ReceiveLike', () => {
                            this.triggerHeartAnimation();
                        });

                        // Real-time audio receive (replaces 1s audio polling!)
                        this.hubConnection.on('ReceiveAudio', (audioData) => {
                            if (!this.isMuted) {
                                this.enqueueAudio(audioData);
                            }
                        });

                        // Real-time live state changes (start/stop)
                        this.hubConnection.on('LiveStateChanged', (isLive, viewerCount, likesCount) => {
                            const wasLive = this.isLive;
                            this.isLive = isLive;
                            this.viewerCount = viewerCount;
                            this.likesCount = likesCount;
                            if (!isLive) {
                                this.currentFrame = null;
                            }
                        });

                        // Real-time comments (replaces polling for chats!)
                        this.hubConnection.on('ReceiveComment', (username, text, color) => {
                            this.chats.push({ username, text, color });
                            if (this.chats.length > 50) this.chats.shift();
                            this.$nextTick(() => {
                                const chatElMobile = this.$refs.chatBoxMobile;
                                const chatElDesktop = this.$refs.chatBoxDesktop;
                                if (chatElMobile) chatElMobile.scrollTop = chatElMobile.scrollHeight;
                                if (chatElDesktop) chatElDesktop.scrollTop = chatElDesktop.scrollHeight;
                            });
                        });

                        // Real-time product updates (after sales, pin changes, etc.)
                        this.hubConnection.on('ProductsUpdated', (products) => {
                            this.liveProducts = products;
                        });

                        // Real-time stats (likes, viewer count)
                        this.hubConnection.on('StatsUpdated', (viewerCount, likesCount) => {
                            if (likesCount > this.likesCount) {
                                const diff = likesCount - this.likesCount;
                                for (let i = 0; i < Math.min(diff, 5); i++) {
                                    setTimeout(() => this.triggerHeartAnimation(), i * 150);
                                }
                            }
                            this.viewerCount = viewerCount;
                            this.likesCount = likesCount;
                        });

                        await this.hubConnection.start();
                        // Declare this connection as a VIEWER so it's counted in viewerCount
                        await this.hubConnection.invoke('SetRole', 'viewer');
                        console.log('[SignalR] Viewer connected - real-time streaming active!');
                    } catch (err) {
                        console.warn('[SignalR] Connection failed, falling back to polling:', err);
                        // Fallback: restart legacy polling if SignalR fails
                        this.pollInterval = setInterval(() => {
                            this.pollState();
                            this.fetchLiveProducts();
                        }, 2000);
                        this.startFramePolling();
                    }
                },

                // ===== AUDIO QUEUE (smooth sequential playback) =====
                enqueueAudio(base64DataUrl) {
                    this.audioQueue.push(base64DataUrl);
                    if (!this.audioPlaying) {
                        this.drainAudioQueue();
                    }
                },
                async drainAudioQueue() {
                    if (this.audioQueue.length === 0) {
                        this.audioPlaying = false;
                        return;
                    }
                    this.audioPlaying = true;
                    // If queue is growing too fast (latency), drop old chunks and keep only latest
                    if (this.audioQueue.length > 3) {
                        this.audioQueue = this.audioQueue.slice(-2);
                    }
                    const chunk = this.audioQueue.shift();
                    await this.playAudioChunk(chunk);
                    this.drainAudioQueue();
                },

                // ===== LEGACY POLLING (fallback only) =====
                startFramePolling() {
                    this.framePollInterval = setInterval(() => {
                        if (this.isLive) this.fetchFrame();
                        else this.currentFrame = null;
                    }, 250);
                },
                stopFramePolling() {
                    if (this.framePollInterval) {
                        clearInterval(this.framePollInterval);
                        this.framePollInterval = null;
                    }
                },
                async fetchFrame() {
                    try {
                        const res = await axios.get('/api/Stream/livestream/frame');
                        this.currentFrame = res.data.frame;
                    } catch (err) { /* silent */ }
                },
                // ===== UTILITY METHODS =====
                formatCurrency(val) {
                    if (!val && val !== 0) return '0 ₫';
                    return new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(val);
                },
                calculateModalTotal() {
                    if (!this.modalProduct) return 0;
                    return this.modalProduct.price * this.buyForm.quantity;
                },
                async fetchLiveProducts() {
                    try {
                        const res = await axios.get('/api/Stream/livestream/products');
                        this.liveProducts = res.data;
                    } catch (err) {
                        console.error('Lỗi tải sản phẩm live:', err);
                    }
                },

                async playAudioChunk(base64DataUrl) {
                    if (this.isMuted) return;
                    try {
                        if (!this.audioContext) {
                            this.audioContext = new (window.AudioContext || window.webkitAudioContext)();
                        }
                        if (this.audioContext.state === 'suspended') {
                            await this.audioContext.resume();
                        }
                        // Convert base64 data URL to ArrayBuffer
                        const base64 = base64DataUrl.split(',')[1];
                        const binaryStr = atob(base64);
                        const bytes = new Uint8Array(binaryStr.length);
                        for (let i = 0; i < binaryStr.length; i++) {
                            bytes[i] = binaryStr.charCodeAt(i);
                        }
                        
                        const audioBuffer = await this.audioContext.decodeAudioData(bytes.buffer);
                        const source = this.audioContext.createBufferSource();
                        source.buffer = audioBuffer;
                        source.connect(this.audioContext.destination);
                        
                        await new Promise((resolve) => {
                            let resolved = false;
                            const timeout = setTimeout(() => {
                                if (!resolved) {
                                    resolved = true;
                                    resolve();
                                }
                            }, 1500); // 1.5s fallback
                            
                            source.onended = () => {
                                if (!resolved) {
                                    resolved = true;
                                    clearTimeout(timeout);
                                    resolve();
                                }
                            };
                            
                            try {
                                source.start(0);
                            } catch (e) {
                                if (!resolved) {
                                    resolved = true;
                                    clearTimeout(timeout);
                                    resolve();
                                }
                            }
                        });
                    } catch (err) {
                        // Decoding errors are expected if chunk is incomplete or corrupted
                    }
                },
                toggleMute() {
                    this.isMuted = !this.isMuted;
                    if (this.isMuted && this.audioContext) {
                        this.audioContext.suspend();
                    } else if (!this.isMuted && this.audioContext) {
                        this.audioContext.resume();
                    }
                },
                async pollState() {
                    try {
                        const res = await axios.get('/api/Stream/livestream/state');
                        const state = res.data;
                        
                        this.isLive = state.isLive;
                        this.viewerCount = state.viewerCount;
                        
                        // Check if likes count increased and trigger floating hearts locally
                        if (state.likesCount > this.likesCount && this.likesCount > 0) {
                            const diff = state.likesCount - this.likesCount;
                            for (let i = 0; i < Math.min(diff, 5); i++) {
                                setTimeout(() => this.triggerHeartAnimation(), i * 150);
                            }
                        }
                        this.likesCount = state.likesCount;

                        // Check if chats changed
                        const previousChatsCount = this.chats.length;
                        this.chats = state.comments;
                        
                        // Scroll to bottom if new messages arrived (handles both mobile and desktop refs)
                        if (this.chats.length > previousChatsCount) {
                            this.$nextTick(() => {
                                const chatElMobile = this.$refs.chatBoxMobile;
                                const chatElDesktop = this.$refs.chatBoxDesktop;
                                if (chatElMobile) {
                                    chatElMobile.scrollTop = chatElMobile.scrollHeight;
                                }
                                if (chatElDesktop) {
                                    chatElDesktop.scrollTop = chatElDesktop.scrollHeight;
                                }
                            });
                        }
                    } catch (err) {
                        console.error('Lỗi polling trạng thái live:', err);
                    }
                },
                async sendUserComment() {
                    if (!this.myComment.trim()) return;
                    
                    if (!this.viewerName || this.viewerName.trim() === '') {
                        const { value: name } = await Swal.fire({
                            title: 'Nhập tên của bạn',
                            input: 'text',
                            inputLabel: 'Vui lòng nhập tên để bắt đầu trò chuyện',
                            inputPlaceholder: 'Nhập tên hiển thị...',
                            background: '#12131a',
                            color: '#fff',
                            confirmButtonColor: '#FE2C55',
                            allowOutsideClick: false,
                            inputValidator: (value) => {
                                if (!value || !value.trim()) {
                                    return 'Bạn phải nhập tên!';
                                }
                            }
                        });
                        
                        if (name) {
                            this.viewerName = name.trim();
                            localStorage.setItem('Stream_viewer_name', this.viewerName);
                        } else {
                            return; // User cancelled
                        }
                    }

                    const textToSend = this.myComment;
                    this.myComment = '';
                    
                    try {
                        await axios.post('/api/Stream/livestream/comment', {
                            username: this.viewerName,
                            text: textToSend
                        });
                        this.pollState();
                    } catch (err) {
                        console.error('Lỗi gửi bình luận:', err);
                    }
                },
                async likeLiveStream() {
                    // Prompt client for name if they don't have one
                    if (!this.viewerName || this.viewerName.trim() === '') {
                        const { value: name } = await Swal.fire({
                            title: 'Nhập tên của bạn',
                            input: 'text',
                            inputLabel: 'Vui lòng nhập tên của bạn để thả tim và tương tác',
                            inputPlaceholder: 'Nhập tên của bạn...',
                            background: '#12131a',
                            color: '#fff',
                            confirmButtonColor: '#FE2C55',
                            allowOutsideClick: false,
                            inputValidator: (value) => {
                                if (!value || !value.trim()) {
                                    return 'Bạn phải nhập tên!';
                                }
                            }
                        });
                        
                        if (name) {
                            this.viewerName = name.trim();
                            localStorage.setItem('Stream_viewer_name', this.viewerName);
                        } else {
                            return; // User cancelled
                        }
                    }

                    this.triggerHeartAnimation();

                    if (this.isLive) {
                        this.personalLikes++;
                        this.isProgressPulsing = true;
                        setTimeout(() => {
                            this.isProgressPulsing = false;
                        }, 150);

                        if (this.personalLikes >= 100) {
                            this.triggerExplosion();
                            this.personalLikes = 0;
                            this.showLocalAnnouncement(this.viewerName);

                            // Broadcast milestone via API
                            try {
                                await axios.post('/api/Stream/livestream/milestone', {
                                    username: this.viewerName
                                });
                            } catch (err) {
                                console.error('Lỗi gửi milestone:', err);
                            }
                        }
                    }

                    try {
                        await axios.post('/api/Stream/livestream/like');
                        this.likesCount++;
                    } catch (err) {
                        console.error('Lỗi thả tim:', err);
                    }
                },
                triggerExplosion() {
                    const container = this.$refs.heartsContainer;
                    if (!container) return;

                    // Giant heart overlay
                    const giantHeartDiv = document.createElement('div');
                    giantHeartDiv.className = 'giant-heart-overlay';
                    const giantHeart = document.createElement('div');
                    giantHeart.className = 'giant-heart';
                    giantHeart.innerText = '❤️';
                    giantHeartDiv.appendChild(giantHeart);
                    
                    // Append to aspect container
                    container.parentElement.appendChild(giantHeartDiv);

                    // Spawn particles
                    setTimeout(() => {
                        for (let i = 0; i < 35; i++) {
                            const particle = document.createElement('div');
                            particle.className = 'heart-particle';
                            particle.innerText = ['❤️', '💖', '💝', '💕', '✨'][Math.floor(Math.random() * 5)];
                            
                            const angle = Math.random() * Math.PI * 2;
                            const distance = 60 + Math.random() * 120;
                            const tx = Math.cos(angle) * distance + 'px';
                            const ty = Math.sin(angle) * distance + 'px';
                            
                            particle.style.setProperty('--tx', tx);
                            particle.style.setProperty('--ty', ty);
                            particle.style.left = '50%';
                            particle.style.top = '50%';
                            
                            giantHeartDiv.appendChild(particle);
                        }
                    }, 500);

                    // Clean up
                    setTimeout(() => {
                        giantHeartDiv.remove();
                    }, 1500);
                },
                showLocalAnnouncement(username) {
                    // Reset any ongoing hiding animation
                    this.isAnnouncementHiding = false;
                    this.announcementName = username;
                    this.showAnnouncement = true;
                    if (this.announcementTimeout) clearTimeout(this.announcementTimeout);

                    this.announcementTimeout = setTimeout(() => {
                        // Trigger slide-out animation first
                        this.isAnnouncementHiding = true;
                        setTimeout(() => {
                            this.showAnnouncement = false;
                            this.isAnnouncementHiding = false;
                        }, 420); // match bannerSlideOut duration
                    }, 6000);
                },
                triggerHeartAnimation() {
                    const heartEl = document.createElement('div');
                    heartEl.className = 'floating-heart';
                    heartEl.innerText = '❤️';
                    
                    const driftX = (Math.random() * 100 - 50) + 'px';
                    const driftXEnd = (Math.random() * 140 - 70) + 'px';
                    heartEl.style.setProperty('--drift-x', driftX);
                    heartEl.style.setProperty('--drift-x-end', driftXEnd);
                    
                    const colors = ['#FE2C55', '#25F4EE', '#FFD700', '#FF69B4', '#00FF00'];
                    heartEl.style.color = colors[Math.floor(Math.random() * colors.length)];
                    
                    const container = this.$refs.heartsContainer;
                    if (container) {
                        container.appendChild(heartEl);
                        setTimeout(() => {
                            heartEl.remove();
                        }, 2500);
                    }
                },
                toggleShoppingList() {
                    this.showShoppingList = !this.showShoppingList;
                },
                async openBuyModal(product) {
                    if (product.stock <= 0) {
                        Swal.fire({
                            title: 'Hết hàng',
                            text: 'Sản phẩm này đã hết hàng trong Livestream!',
                            icon: 'warning',
                            background: '#12131a',
                            color: '#fff',
                            confirmButtonColor: '#FE2C55'
                        });
                        return;
                    }
                    this.modalProduct = product;
                    this.buyForm.quantity = 1;
                    this.productVariants = [];
                    this.selectedVariant = null;
                    
                    try {
                        const res = await axios.get(`/api/Stream/livestream/products/${product.productId}/variants`);
                        this.productVariants = res.data;
                        
                        // Auto-select first variant that has stock
                        this.selectedVariant = this.productVariants.find(v => v.stock > 0) || this.productVariants[0] || null;
                    } catch (err) {
                        console.error('Lỗi tải biến thể sản phẩm:', err);
                        // Fallback to standard variant if loading fails
                        this.productVariants = [{
                            productId: product.productId,
                            name: product.name,
                            sku: product.sku,
                            price: product.price,
                            imageUrl: product.imageUrl,
                            stock: product.stock,
                            label: 'Mặc định'
                        }];
                        this.selectedVariant = this.productVariants[0];
                    }
                    
                    this.showBuySheet = true;
                },
                closeBuySheet() {
                    this.showBuySheet = false;
                },
                selectVariant(variant) {
                    if (variant.stock <= 0) return;
                    this.selectedVariant = variant;
                    this.buyForm.quantity = 1; // Reset to 1 on variant change
                },
                changeQty(amount) {
                    const maxStock = this.selectedVariant ? this.selectedVariant.stock : (this.modalProduct ? this.modalProduct.stock : 99);
                    let newQty = this.buyForm.quantity + amount;
                    if (newQty < 1) newQty = 1;
                    if (newQty > maxStock) newQty = maxStock;
                    this.buyForm.quantity = newQty;
                },
                calculateModalTotal() {
                    if (!this.modalProduct) return 0;
                    const basePrice = this.selectedVariant ? this.selectedVariant.price : this.modalProduct.price;
                    return basePrice * this.buyForm.quantity;
                },
                goToCheckout() {
                    if (!this.modalProduct) return;
                    const checkoutData = {
                        product: this.modalProduct,
                        selectedVariant: this.selectedVariant,
                        quantity: this.buyForm.quantity,
                        totalPrice: this.calculateModalTotal()
                    };
                    sessionStorage.setItem('Stream_checkout_data', JSON.stringify(checkoutData));
                    window.location.href = '/Home/OrderCheckout';
                }
            }
        });
    </script>
}


