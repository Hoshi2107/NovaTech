<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\FakeTikTokShop.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <!-- Disable IIS dynamic compression to prevent double-encoding with ASP.NET ResponseCompression -->
      <!-- This fixes ERR_CONTENT_DECODING_FAILED on HTTPS hosted environments -->
      <urlCompression doDynamicCompression="false" doStaticCompression="false" />
    </system.webServer>
  </location>
</configuration>