@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Bán hàng & Chăm sóc khách hàng";
    ViewData["BreadcrumbActive"] = "Bán hàng & Chăm sóc khách hàng";
}

@section Styles {
    <style>
        .cskh-shell {
            display: grid;
            grid-template-columns: 360px 1fr;
            gap: 18px;
            min-height: 660px;
        }

        .cskh-panel {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            box-shadow: 0 12px 30px rgba(15, 23, 42, 0.06);
            overflow: hidden;
        }

        .thread-list {
            max-height: 500px;
            overflow-y: auto;
        }

        .thread-item {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            cursor: pointer;
            transition: all 0.2s ease;
            background: #ffffff;
        }

        .thread-item:hover,
        .thread-item.active {
            background: #eff6ff;
        }

        .thread-name {
            font-weight: 800;
            color: #0f172a;
        }

        .thread-subject {
            font-size: 13px;
            color: #475569;
            margin-top: 4px;
        }

        .thread-last {
            font-size: 12px;
            color: #64748b;
            margin-top: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .badge-unread {
            background: #ef4444;
            color: #ffffff;
            border-radius: 999px;
            padding: 3px 8px;
            font-size: 11px;
            font-weight: 800;
        }

        .thread-status {
            border-radius: 999px;
            padding: 3px 8px;
            font-size: 11px;
            font-weight: 800;
            white-space: nowrap;
        }

        .thread-status.unread {
            background: #fee2e2;
            color: #b91c1c;
        }

        .thread-status.processing {
            background: #fef3c7;
            color: #92400e;
        }

        .thread-status.replied {
            background: #dcfce7;
            color: #166534;
        }

        .thread-status.closed {
            background: #e2e8f0;
            color: #475569;
        }

        .chat-main {
            display: flex;
            flex-direction: column;
            min-height: 660px;
        }

        .chat-main-header {
            padding: 18px;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
        }

        .customer-mini-card {
            margin-top: 12px;
            padding: 12px;
            border-radius: 14px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
        }

        .customer-mini-label {
            font-size: 11px;
            color: #64748b;
            font-weight: 800;
            text-transform: uppercase;
        }

        .customer-mini-value {
            font-size: 13px;
            color: #0f172a;
            font-weight: 700;
        }

        .chat-messages {
            flex: 1;
            padding: 18px;
            overflow-y: auto;
            background: #f8fafc;
        }

        .chat-message {
            display: flex;
            margin-bottom: 12px;
        }

        .chat-message.customer {
            justify-content: flex-start;
        }

        .chat-message.staff {
            justify-content: flex-end;
        }

        .chat-bubble {
            max-width: 70%;
            padding: 11px 13px;
            border-radius: 16px;
            font-size: 14px;
            line-height: 1.45;
            box-shadow: 0 4px 12px rgba(15, 23, 42, 0.05);
        }

        .chat-message.customer .chat-bubble {
            background: #ffffff;
            color: #0f172a;
            border: 1px solid #e2e8f0;
            border-bottom-left-radius: 4px;
        }

        .chat-message.staff .chat-bubble {
            background: #2563eb;
            color: #ffffff;
            border-bottom-right-radius: 4px;
        }

        .chat-sender {
            font-size: 11px;
            font-weight: 800;
            opacity: 0.75;
            margin-bottom: 4px;
        }

        .chat-time {
            display: block;
            font-size: 10px;
            opacity: 0.7;
            margin-top: 5px;
        }

        .chat-msg-img {
            display: block;
            max-width: 220px;
            max-height: 180px;
            border-radius: 12px;
            margin-top: 6px;
            object-fit: cover;
            cursor: pointer;
            transition: transform 0.2s ease;
            border: 1.5px solid rgba(255,255,255,0.3);
        }

        .chat-msg-img:hover {
            transform: scale(1.03);
        }

        /* Lightbox phóng to ảnh trong admin */
        .admin-lightbox {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 99999;
            background: rgba(0,0,0,0.85);
            align-items: center;
            justify-content: center;
            cursor: zoom-out;
        }

        .admin-lightbox.active {
            display: flex;
        }

        .admin-lightbox img {
            max-width: 90vw;
            max-height: 88vh;
            border-radius: 16px;
            box-shadow: 0 28px 70px rgba(0,0,0,0.6);
            object-fit: contain;
        }

        /* Preview ảnh trong ô reply */
        .admin-img-preview {
            margin-bottom: 8px;
        }

        .admin-img-preview img {
            max-width: 100px;
            max-height: 80px;
            border-radius: 10px;
            border: 2px solid #dbeafe;
            object-fit: cover;
        }

        .reply-box {
            padding: 16px;
            border-top: 1px solid #e2e8f0;
            background: #ffffff;
        }

        .empty-state {
            height: 100%;
            min-height: 520px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #64748b;
            text-align: center;
        }

        .reply-disabled-note {
            font-size: 12px;
            color: #64748b;
            font-weight: 600;
        }

        .inbox-footer {
            padding: 10px 14px;
            border-top: 1px solid #e2e8f0;
            background: #f8fafc;
            font-size: 12px;
            color: #64748b;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
        }

        .page-mini-btn {
            border: 1px solid #bae6fd;
            background: #ffffff;
            color: #0284c7;
            border-radius: 999px;
            padding: 4px 10px;
            font-size: 12px;
            font-weight: 800;
        }

        .page-mini-btn:disabled {
            color: #94a3b8;
            background: #f1f5f9;
            border-color: #e2e8f0;
        }

        .thread-action-btn {
            font-weight: 800;
            box-shadow: 0 6px 14px rgba(15, 23, 42, 0.06);
            transition: all 0.18s ease;
        }

        .thread-action-btn:hover {
            transform: translateY(-1px);
        }

        .cskh-confirm-modal {
            position: fixed;
            inset: 0;
            z-index: 10000;
            display: flex;
            align-items: center;
            justify-content: center;
            animation: cskhFadeIn 0.2s ease;
        }

        .cskh-confirm-modal.d-none {
            display: none !important;
        }

        .cskh-confirm-backdrop {
            position: absolute;
            inset: 0;
            background: rgba(15, 23, 42, 0.48);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
        }

        .cskh-confirm-box {
            position: relative;
            width: min(440px, calc(100vw - 28px));
            background: #ffffff;
            border-radius: 26px;
            padding: 26px 22px 22px;
            box-shadow: 0 28px 70px rgba(15, 23, 42, 0.30);
            border: 1px solid #e2e8f0;
            text-align: center;
            animation: cskhZoomIn 0.25s ease;
        }

        .cskh-confirm-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 15px;
            border-radius: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            color: #ffffff;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            box-shadow: 0 14px 28px rgba(239, 68, 68, 0.25);
        }

        .cskh-confirm-icon.warning {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            box-shadow: 0 14px 28px rgba(245, 158, 11, 0.25);
        }

        .cskh-confirm-title {
            font-size: 22px;
            font-weight: 900;
            color: #0f172a;
            margin-bottom: 10px;
        }

        .cskh-confirm-text {
            font-size: 14px;
            line-height: 1.6;
            color: #475569;
            margin-bottom: 22px;
        }

        .cskh-confirm-text strong {
            color: #dc2626;
        }

        .cskh-confirm-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .cskh-confirm-btn {
            min-width: 122px;
            border: 0;
            border-radius: 15px;
            padding: 12px 16px;
            font-size: 14px;
            font-weight: 900;
            cursor: pointer;
            transition: all 0.22s ease;
        }

        .cskh-confirm-btn.btn-cancel {
            background: #f1f5f9;
            color: #334155;
        }

        .cskh-confirm-btn.btn-cancel:hover {
            background: #e2e8f0;
            transform: translateY(-1px);
        }

        .cskh-confirm-btn.btn-ok {
            color: #ffffff;
            background: linear-gradient(135deg, #ef4444, #dc2626);
            box-shadow: 0 12px 24px rgba(239, 68, 68, 0.25);
        }

        .cskh-confirm-btn.btn-ok.warning {
            background: linear-gradient(135deg, #f59e0b, #d97706);
            box-shadow: 0 12px 24px rgba(245, 158, 11, 0.25);
        }

        .cskh-confirm-btn.btn-ok:hover {
            transform: translateY(-2px);
        }

        @@keyframes cskhFadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        @@keyframes cskhZoomIn {
            from {
                opacity: 0;
                transform: scale(0.92) translateY(10px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        @@media (max-width: 992px) {
            .cskh-shell {
                grid-template-columns: 1fr;
            }

            .thread-list {
                max-height: 360px;
            }
        }

        @@media (max-width: 576px) {
            .cskh-confirm-actions {
                flex-direction: column;
            }

            .cskh-confirm-btn {
                width: 100%;
            }
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">
            <i class="fa-solid fa-headset text-info me-2"></i>
            Bán hàng & Chăm sóc khách hàng
        </h3>
        <div class="text-muted small">Quản lý hội thoại khách hàng từ website NovaTech Store.</div>
    </div>

    <button class="btn btn-outline-primary rounded-pill" onclick="loadInbox(true)">
        <i class="fa-solid fa-rotate me-2"></i>Làm mới
    </button>
</div>

<div class="cskh-shell">
    <div class="cskh-panel">
        <div class="p-3 border-bottom bg-white">
            <h6 class="fw-bold mb-3">Hộp thư khách hàng</h6>

            <input id="inboxKeyword"
                   type="text"
                   class="form-control form-control-sm mb-2"
                   placeholder="Tìm tên, SĐT, nội dung chat..." />

            <div class="row g-2">
                <div class="col-6">
                    <select id="inboxStatus" class="form-select form-select-sm">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Unread">Chưa đọc</option>
                        <option value="Processing">Đang xử lý</option>
                        <option value="Replied">Đã phản hồi</option>
                        <option value="Closed">Đã đóng</option>
                    </select>
                </div>

                <div class="col-6">
                    <select id="inboxPageSize" class="form-select form-select-sm">
                        <option value="10">10 dòng</option>
                        <option value="20" selected>20 dòng</option>
                        <option value="50">50 dòng</option>
                    </select>
                </div>
            </div>

            <button class="btn btn-info text-white w-100 rounded-pill mt-2 fw-bold" onclick="applyInboxFilter()">
                <i class="fa-solid fa-magnifying-glass me-1"></i>
                Lọc hội thoại
            </button>
        </div>

        <div id="threadList" class="thread-list">
            <div class="p-4 text-center text-muted">Đang tải hội thoại...</div>
        </div>

        <div class="inbox-footer">
            <button id="prevInboxPage" class="page-mini-btn" onclick="changeInboxPage(-1)" disabled>
                <i class="fa-solid fa-chevron-left"></i>
            </button>

            <span id="inboxPageInfo">Tổng: 0 hội thoại</span>

            <button id="nextInboxPage" class="page-mini-btn" onclick="changeInboxPage(1)" disabled>
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    </div>

    <div class="cskh-panel chat-main">
        <div id="chatHeader" class="chat-main-header">
            <div class="fw-bold text-dark">Chưa chọn hội thoại</div>
            <div class="text-muted small">Chọn một khách hàng bên trái để xem nội dung.</div>
        </div>

        <div id="chatMessages" class="chat-messages">
            <div class="empty-state">
                <div>
                    <i class="fa-regular fa-comments fs-1 mb-3 text-info"></i>
                    <div>Chọn hội thoại để bắt đầu chăm sóc khách hàng.</div>
                </div>
            </div>
        </div>

        <div class="reply-box">
            <textarea id="replyText"
                      class="form-control mb-2"
                      rows="3"
                      placeholder="Vui lòng chọn hội thoại trước khi phản hồi..."
                      disabled></textarea>

            <!-- Preview ảnh NV đã chọn -->
            <div id="adminImgPreviewBox" class="admin-img-preview d-none">
                <div class="d-flex align-items-center gap-2">
                    <img id="adminPreviewImg" src="" alt="preview" />
                    <button type="button" id="adminRemoveImgBtn" class="btn btn-sm btn-outline-danger rounded-pill">
                        <i class="fa-solid fa-xmark me-1"></i>Xóa ảnh
                    </button>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <div id="replyStatus" class="small text-muted"></div>
                    <div id="replyLockNote" class="reply-disabled-note">
                        Ô phản hồi sẽ mở sau khi chọn hội thoại.
                    </div>
                </div>

                <div class="d-flex gap-2 align-items-center">
                    <!-- Nút đính kèm ảnh cho NV -->
                    <input type="file" id="adminFileInput" accept="image/jpeg,image/png,image/webp,image/gif" style="display:none" />
                    <button type="button"
                            id="adminAttachBtn"
                            class="btn btn-outline-secondary rounded-pill px-3"
                            disabled
                            onclick="document.getElementById('adminFileInput').click()">
                        <i class="fa-solid fa-image me-1"></i>Đính kèm ảnh
                    </button>

                    <button id="sendReplyBtn"
                            class="btn btn-primary rounded-pill px-4"
                            onclick="sendReply()"
                            disabled>
                        <i class="fa-solid fa-paper-plane me-2"></i>
                        Gửi phản hồi
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<div id="cskhConfirmModal" class="cskh-confirm-modal d-none">
    <div class="cskh-confirm-backdrop"></div>

    <div class="cskh-confirm-box">
        <div id="cskhConfirmIcon" class="cskh-confirm-icon">
            <i id="cskhConfirmIconClass" class="fa-solid fa-trash-can"></i>
        </div>

        <div id="cskhConfirmTitle" class="cskh-confirm-title">
            Xác nhận thao tác
        </div>

        <div id="cskhConfirmText" class="cskh-confirm-text">
            Bạn có chắc muốn thực hiện thao tác này không?
        </div>

        <div class="cskh-confirm-actions">
            <button type="button" id="cskhConfirmCancel" class="cskh-confirm-btn btn-cancel">
                Hủy
            </button>

            <button type="button" id="cskhConfirmOk" class="cskh-confirm-btn btn-ok">
                Xác nhận
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Lightbox admin -->
    <div id="adminLightbox" class="admin-lightbox">
        <img id="adminLightboxImg" src="" alt="" />
    </div>

    <script>
        let selectedThreadId = null;
        let selectedThreadStatus = null;
        let currentThreads = [];
        let currentInboxPage = 1;
        let currentInboxTotalPages = 1;
        let currentInboxTotalItems = 0;
        let inboxLoadedOnce = false;
        let inboxRequestRunning = false;
        let threadRequestToken = 0;
        let isUserBusy = false;
        let lastThreadRenderKey = "";
        let lastInboxRenderKey = "";
        let adminSelectedImageUrl = null; // Ảnh NV chọn để gửi

        const CSKH_REFRESH_INTERVAL = 60 * 1000;


        function formatTime(value) {
            if (!value) return '';

            return new Date(value).toLocaleString('vi-VN', {
                hour: '2-digit',
                minute: '2-digit',
                day: '2-digit',
                month: '2-digit'
            });
        }

        function escapeHtml(value) {
            return String(value || '')
                .replaceAll('&', '&amp;')
                .replaceAll('<', '&lt;')
                .replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;')
                .replaceAll("'", '&#039;');
        }

        function sameId(a, b) {
            return String(a) === String(b);
        }

        function statusMeta(status) {
            switch (status) {
                case 'Unread':
                    return { label: 'Chưa đọc', className: 'unread' };
                case 'Processing':
                    return { label: 'Đang xử lý', className: 'processing' };
                case 'Replied':
                    return { label: 'Đã phản hồi', className: 'replied' };
                case 'Closed':
                    return { label: 'Đã đóng', className: 'closed' };
                default:
                    return { label: 'Chưa đọc', className: 'unread' };
            }
        }

        function getRank(points) {
            points = Number(points || 0);

            if (points >= 3000) return 'Kim Cương';
            if (points >= 1500) return 'Vàng';
            if (points >= 500) return 'Bạc';
            return 'Đồng';
        }

        function buildInboxRenderKey(items) {
            return [
                currentInboxPage,
                currentInboxTotalPages,
                currentInboxTotalItems,
                selectedThreadId || '',
                ...items.map(t => [
                    t.id,
                    t.status,
                    t.unreadCount,
                    t.updatedAt,
                    t.lastMessage,
                    t.customerName
                ].join(':'))
            ].join('|');
        }

        function buildThreadRenderKey(thread) {
            const messages = Array.isArray(thread.messages) ? thread.messages : [];
            const lastMessage = messages.length > 0 ? messages[messages.length - 1] : null;

            return [
                thread.id,
                thread.status,
                thread.customerId,
                thread.customerName,
                thread.customerPhone,
                thread.customerEmail,
                thread.customerPoints,
                messages.length,
                lastMessage ? lastMessage.id : '',
                lastMessage ? lastMessage.text : '',
                lastMessage ? lastMessage.timestamp : ''
            ].join('|');
        }

        async function postJson(url, body) {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(body)
            });

            let data = {};

            try {
                data = await response.json();
            } catch {
                data = {};
            }

            if (!response.ok) {
                throw new Error(data.message || 'Có lỗi xảy ra.');
            }

            return data;
        }

        function openCskhConfirm(options) {
            return new Promise((resolve) => {
                const modal = document.getElementById('cskhConfirmModal');
                const iconBox = document.getElementById('cskhConfirmIcon');
                const icon = document.getElementById('cskhConfirmIconClass');
                const title = document.getElementById('cskhConfirmTitle');
                const text = document.getElementById('cskhConfirmText');
                const okBtn = document.getElementById('cskhConfirmOk');
                const cancelBtn = document.getElementById('cskhConfirmCancel');

                title.textContent = options.title || 'Xác nhận thao tác';
                text.innerHTML = options.html || escapeHtml(options.text || 'Bạn có chắc muốn thực hiện thao tác này không?');
                okBtn.innerHTML = options.okText || 'Xác nhận';

                icon.className = options.icon || 'fa-solid fa-trash-can';
                iconBox.className = options.warning
                    ? 'cskh-confirm-icon warning'
                    : 'cskh-confirm-icon';

                okBtn.className = options.warning
                    ? 'cskh-confirm-btn btn-ok warning'
                    : 'cskh-confirm-btn btn-ok';

                modal.classList.remove('d-none');

                function cleanup() {
                    okBtn.removeEventListener('click', handleOk);
                    cancelBtn.removeEventListener('click', handleCancel);
                    modal.removeEventListener('click', handleBackdrop);
                    document.removeEventListener('keydown', handleEsc);
                    modal.classList.add('d-none');
                }

                function handleOk() {
                    cleanup();
                    resolve(true);
                }

                function handleCancel() {
                    cleanup();
                    resolve(false);
                }

                function handleBackdrop(event) {
                    if (event.target.classList.contains('cskh-confirm-backdrop')) {
                        cleanup();
                        resolve(false);
                    }
                }

                function handleEsc(event) {
                    if (event.key === 'Escape') {
                        cleanup();
                        resolve(false);
                    }
                }

                okBtn.addEventListener('click', handleOk);
                cancelBtn.addEventListener('click', handleCancel);
                modal.addEventListener('click', handleBackdrop);
                document.addEventListener('keydown', handleEsc);
            });
        }

        function updateReplyState(enabled, placeholder, note) {
            const input = document.getElementById('replyText');
            const button = document.getElementById('sendReplyBtn');
            const lockNote = document.getElementById('replyLockNote');
            const attachBtn = document.getElementById('adminAttachBtn');

            input.disabled = !enabled;
            button.disabled = !enabled;
            if (attachBtn) attachBtn.disabled = !enabled;
            input.placeholder = placeholder;
            lockNote.textContent = note || '';
        }

        function resetChatPane(message) {
            document.getElementById('chatHeader').innerHTML = `
                <div class="fw-bold text-dark">Chưa chọn hội thoại</div>
                <div class="text-muted small">Chọn một khách hàng bên trái để xem nội dung.</div>
            `;

            document.getElementById('chatMessages').innerHTML = `
                <div class="empty-state">
                    <div>
                        <i class="fa-regular fa-comments fs-1 mb-3 text-info"></i>
                        <div>${escapeHtml(message || 'Chọn hội thoại để bắt đầu chăm sóc khách hàng.')}</div>
                    </div>
                </div>
            `;

            document.getElementById('replyText').value = '';

            updateReplyState(
                false,
                'Vui lòng chọn hội thoại trước khi phản hồi...',
                'Ô phản hồi sẽ mở sau khi chọn hội thoại.'
            );
        }

        function renderInbox() {
            const list = document.getElementById('threadList');

            if (!currentThreads.length) {
                list.innerHTML = '<div class="p-4 text-center text-muted">Chưa có hội thoại nào.</div>';
                return;
            }

            list.innerHTML = currentThreads.map(thread => {
                const meta = statusMeta(thread.status);

                return `
                    <div class="thread-item ${sameId(selectedThreadId, thread.id) ? 'active' : ''}" onclick="selectThread(${thread.id})">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="thread-name">${escapeHtml(thread.customerName || 'Khách hàng')}</div>
                            <div class="d-flex gap-1 align-items-center flex-wrap justify-content-end">
                                ${thread.unreadCount > 0 ? `<span class="badge-unread">${thread.unreadCount}</span>` : ''}
                                <span class="thread-status ${meta.className}">${meta.label}</span>
                            </div>
                        </div>

                        <div class="thread-subject">${escapeHtml(thread.subject || 'Chat hỗ trợ NovaTech')}</div>
                        <div class="thread-last">${escapeHtml(thread.lastMessage || '')}</div>
                        <div class="small text-muted mt-1">${formatTime(thread.updatedAt)}</div>
                    </div>
                `;
            }).join('');
        }

        function renderInboxPageInfo() {
            const info = document.getElementById('inboxPageInfo');
            const prev = document.getElementById('prevInboxPage');
            const next = document.getElementById('nextInboxPage');

            info.textContent = `Trang ${currentInboxPage}/${currentInboxTotalPages} · Tổng: ${currentInboxTotalItems} hội thoại`;

            prev.disabled = currentInboxPage <= 1;
            next.disabled = currentInboxPage >= currentInboxTotalPages;
        }

        function getInboxQuery() {
            const keyword = document.getElementById('inboxKeyword').value.trim();
            const status = document.getElementById('inboxStatus').value;
            const pageSize = document.getElementById('inboxPageSize').value;

            const params = new URLSearchParams();
            params.set('page', currentInboxPage);
            params.set('pageSize', pageSize);

            if (keyword) {
                params.set('keyword', keyword);
            }

            if (status) {
                params.set('status', status);
            }

            return params.toString();
        }

        async function loadInbox(showLoading = false) {
            const list = document.getElementById('threadList');

            if (inboxRequestRunning || isUserBusy) {
                return;
            }

            inboxRequestRunning = true;

            if (showLoading && !inboxLoadedOnce) {
                list.innerHTML = '<div class="p-4 text-center text-muted">Đang tải hội thoại...</div>';
            }

            try {
                const response = await fetch(`/SalesCSKH/GetCustomerInbox?${getInboxQuery()}`);

                if (!response.ok) {
                    throw new Error('Không tải được danh sách hội thoại.');
                }

                const result = await response.json();
                const incomingThreads = Array.isArray(result) ? result : (result.items || []);

                currentThreads = incomingThreads;
                currentInboxPage = result.currentPage || currentInboxPage;
                currentInboxTotalPages = result.totalPages || 1;
                currentInboxTotalItems = result.totalItems || incomingThreads.length;
                inboxLoadedOnce = true;

                const newInboxKey = buildInboxRenderKey(currentThreads);

                if (showLoading || newInboxKey !== lastInboxRenderKey) {
                    lastInboxRenderKey = newInboxKey;
                    renderInbox();
                    renderInboxPageInfo();
                }
            } catch (err) {
                list.innerHTML = `<div class="p-4 text-danger text-center">${escapeHtml(err.message)}</div>`;
            } finally {
                inboxRequestRunning = false;
            }
        }

        async function applyInboxFilter() {
            currentInboxPage = 1;
            lastInboxRenderKey = "";
            await loadInbox(true);
        }

        async function changeInboxPage(step) {
            const nextPage = currentInboxPage + step;

            if (nextPage < 1 || nextPage > currentInboxTotalPages) {
                return;
            }

            currentInboxPage = nextPage;
            lastInboxRenderKey = "";
            await loadInbox(true);
        }

        async function selectThread(id) {
            selectedThreadId = id;

            document.getElementById('replyStatus').textContent = '';
            document.getElementById('replyText').value = '';

            lastInboxRenderKey = "";
            renderInbox();

            await loadThread(id, false, true);

            try {
                const result = await postJson('/SalesCSKH/MarkCustomerThreadRead', {
                    threadId: id
                });

                const thread = currentThreads.find(t => sameId(t.id, id));

                if (thread) {
                    thread.unreadCount = 0;

                    if (thread.status === 'Unread') {
                        thread.status = 'Processing';
                    }
                }

                if (result.thread) {
                    selectedThreadStatus = result.thread.status;
                }

                lastInboxRenderKey = "";
                renderInbox();
            } catch (err) {
                console.error(err);
            }
        }

        async function loadThread(id, silent = false, forceRender = false) {
            const header = document.getElementById('chatHeader');
            const messagesBox = document.getElementById('chatMessages');

            const requestToken = ++threadRequestToken;

            if (!silent) {
                messagesBox.innerHTML = '<div class="p-4 text-center text-muted">Đang tải nội dung...</div>';
            }

            try {
                const response = await fetch(`/SalesCSKH/GetCustomerThread?id=${id}`);

                if (!response.ok) {
                    throw new Error('Không tải được nội dung hội thoại.');
                }

                const thread = await response.json();

                if (requestToken !== threadRequestToken || !sameId(selectedThreadId, id)) {
                    return;
                }

                const newThreadKey = buildThreadRenderKey(thread);

                if (silent && !forceRender && newThreadKey === lastThreadRenderKey) {
                    return;
                }

                lastThreadRenderKey = newThreadKey;
                selectedThreadStatus = thread.status;

                const meta = statusMeta(thread.status);
                const rank = getRank(thread.customerPoints);

                const profileButton = thread.canOpenCustomerProfile
                    ? `<a href="/Customer/Detail?id=${encodeURIComponent(thread.customerId)}" class="btn btn-sm btn-outline-info rounded-pill px-3 thread-action-btn">
                           <i class="fa-solid fa-id-card me-1"></i>Xem hồ sơ
                       </a>`
                    : `<button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3 thread-action-btn" disabled>
                           <i class="fa-solid fa-id-card me-1"></i>Chưa có hồ sơ
                       </button>`;

                const closeButton = thread.status === 'Closed'
                    ? `<button type="button" class="btn btn-sm btn-secondary rounded-pill px-3 thread-action-btn" disabled>
                           <i class="fa-solid fa-lock me-1"></i>Đã đóng
                       </button>`
                    : `<button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 thread-action-btn" onclick="closeThread()">
                           <i class="fa-solid fa-circle-xmark me-1"></i>Đóng hội thoại
                       </button>`;

                const deleteButton = `
                    <button type="button"
                            class="btn btn-sm btn-danger rounded-pill px-3 thread-action-btn"
                            onclick="deleteThread()">
                        <i class="fa-solid fa-trash-can me-1"></i>
                        Xóa hội thoại
                    </button>
                `;

                header.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="fw-bold text-dark fs-5">${escapeHtml(thread.customerName || 'Khách hàng')}</div>
                                <span class="thread-status ${meta.className}">${meta.label}</span>
                            </div>

                            <div class="text-muted small mt-1">
                                ${escapeHtml(thread.subject || 'Chat hỗ trợ NovaTech')}
                                ${thread.customerPhone ? ` · ${escapeHtml(thread.customerPhone)}` : ''}
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-wrap justify-content-end">
                            ${profileButton}
                            ${closeButton}
                            ${deleteButton}
                        </div>
                    </div>

                    <div class="customer-mini-card">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <div class="customer-mini-label">SĐT</div>
                                <div class="customer-mini-value">${escapeHtml(thread.customerPhone || 'Chưa có')}</div>
                            </div>

                            <div class="col-md-3">
                                <div class="customer-mini-label">Email</div>
                                <div class="customer-mini-value">${escapeHtml(thread.customerEmail || 'Chưa có')}</div>
                            </div>

                            <div class="col-md-3">
                                <div class="customer-mini-label">Điểm / Hạng</div>
                                <div class="customer-mini-value">${Number(thread.customerPoints || 0)} điểm · ${rank}</div>
                            </div>

                            <div class="col-md-3">
                                <div class="customer-mini-label">Kênh</div>
                                <div class="customer-mini-value">${escapeHtml(thread.channel || 'Website')}</div>
                            </div>
                        </div>
                    </div>
                `;

                const messages = Array.isArray(thread.messages) ? thread.messages : [];

                if (!messages.length) {
                    messagesBox.innerHTML = '<div class="empty-state">Hội thoại chưa có tin nhắn.</div>';
                } else {
                    messagesBox.innerHTML = messages.map(message => {
                        const imgHtml = message.imageUrl
                            ? `<img class="chat-msg-img" src="${escapeHtml(message.imageUrl)}" alt="ảnh" onclick="adminOpenLightbox('${escapeHtml(message.imageUrl)}')" />`
                            : '';
                        return `
                        <div class="chat-message ${message.sender === 'customer' ? 'customer' : 'staff'}">
                            <div class="chat-bubble">
                                <div class="chat-sender">${message.sender === 'customer' ? 'Khách hàng' : 'NovaTech'}</div>
                                ${message.text ? `<div>${escapeHtml(message.text)}</div>` : ''}
                                ${imgHtml}
                                <span class="chat-time">${formatTime(message.timestamp)}</span>
                            </div>
                        </div>
                        `;
                    }).join('');

                    messagesBox.scrollTop = messagesBox.scrollHeight;
                }


                if (thread.status === 'Closed') {
                    updateReplyState(
                        false,
                        'Hội thoại đã đóng, không thể phản hồi.',
                        'Hội thoại này đã đóng. Mở hội thoại mới nếu khách cần hỗ trợ tiếp.'
                    );
                } else {
                    updateReplyState(
                        true,
                        'Nhập phản hồi cho khách hàng...',
                        'Nhân viên có thể phản hồi và hệ thống sẽ đánh dấu đã phản hồi.'
                    );
                }
            } catch (err) {
                if (!silent) {
                    messagesBox.innerHTML = `<div class="p-4 text-danger text-center">${escapeHtml(err.message)}</div>`;
                }
            }
        }

        async function loadThreadIfChanged(id) {
            if (!id || isUserBusy || document.hidden) {
                return;
            }

            await loadThread(id, true, false);
        }

        async function sendReply() {
            const status = document.getElementById('replyStatus');
            const input = document.getElementById('replyText');
            const message = input.value.trim();
            const imageUrl = adminSelectedImageUrl;

            status.textContent = '';

            if (!selectedThreadId) {
                status.textContent = 'Vui lòng chọn hội thoại.';
                status.className = 'small text-danger';
                return;
            }

            if (selectedThreadStatus === 'Closed') {
                status.textContent = 'Hội thoại đã đóng. Không thể gửi phản hồi.';
                status.className = 'small text-danger';
                return;
            }

            if (!message && !imageUrl) {
                status.textContent = 'Vui lòng nhập nội dung phản hồi hoặc đính kèm ảnh.';
                status.className = 'small text-danger';
                return;
            }

            try {
                isUserBusy = true;
                status.textContent = 'Đang gửi...';
                status.className = 'small text-muted';

                const result = await postJson('/SalesCSKH/ReplyCustomerMessage', {
                    threadId: selectedThreadId,
                    message: message,
                    imageUrl: imageUrl,
                    status: 'Replied'
                });

                input.value = '';
                adminClearImagePreview();
                status.textContent = 'Đã gửi phản hồi.';
                status.className = 'small text-success';


                const thread = currentThreads.find(t => sameId(t.id, selectedThreadId));

                if (thread) {
                    thread.lastMessage = message;
                    thread.updatedAt = new Date().toISOString();
                    thread.status = 'Replied';
                    thread.unreadCount = 0;
                }

                if (result.thread) {
                    selectedThreadStatus = result.thread.status;
                    lastThreadRenderKey = "";
                }

                lastInboxRenderKey = "";
                renderInbox();

                await loadThread(selectedThreadId, false, true);
                await loadInbox(false);
            } catch (err) {
                status.textContent = err.message;
                status.className = 'small text-danger';
            } finally {
                isUserBusy = false;
            }
        }

        // Admin lightbox
        function adminOpenLightbox(src) {
            const lb = document.getElementById('adminLightbox');
            const lbImg = document.getElementById('adminLightboxImg');
            lbImg.src = src;
            lb.classList.add('active');
        }

        document.getElementById('adminLightbox').addEventListener('click', function () {
            this.classList.remove('active');
            document.getElementById('adminLightboxImg').src = '';
        });

        // Admin image attach
        function adminClearImagePreview() {
            adminSelectedImageUrl = null;
            document.getElementById('adminPreviewImg').src = '';
            document.getElementById('adminImgPreviewBox').classList.add('d-none');
            document.getElementById('adminFileInput').value = '';
        }

        document.getElementById('adminFileInput').addEventListener('change', async function () {
            const file = this.files[0];
            if (!file) return;

            const status = document.getElementById('replyStatus');
            const previewImg = document.getElementById('adminPreviewImg');
            const previewBox = document.getElementById('adminImgPreviewBox');

            // Hiện preview tạm
            previewImg.src = URL.createObjectURL(file);
            previewBox.classList.remove('d-none');
            status.textContent = 'Đang tải ảnh lên...';
            status.className = 'small text-muted';

            try {
                const formData = new FormData();
                formData.append('file', file);

                const response = await fetch('/SalesCSKH/UploadChatImage', {
                    method: 'POST',
                    body: formData
                });

                let data = {};
                try { data = await response.json(); } catch { data = {}; }

                if (!response.ok) throw new Error(data.message || 'Không tải ảnh được.');

                adminSelectedImageUrl = data.imageUrl;
                status.textContent = 'Ảnh đã sẵn sàng. Nhấn Gửi để gửi kèm ảnh.';
                status.className = 'small text-success';
            } catch (err) {
                adminClearImagePreview();
                status.textContent = err.message;
                status.className = 'small text-danger';
            }
        });

        document.getElementById('adminRemoveImgBtn').addEventListener('click', function () {
            adminClearImagePreview();
            document.getElementById('replyStatus').textContent = '';
        });

        document.getElementById('replyText').addEventListener('paste', async function (event) {
            const items = (event.clipboardData || (event.originalEvent && event.originalEvent.clipboardData))?.items;
            if (!items) return;

            for (const item of items) {
                if (item.type.indexOf('image') !== -1) {
                    event.preventDefault();
                    const file = item.getAsFile();
                    if (!file) continue;

                    const status = document.getElementById('replyStatus');
                    const previewImg = document.getElementById('adminPreviewImg');
                    const previewBox = document.getElementById('adminImgPreviewBox');

                    previewImg.src = URL.createObjectURL(file);
                    previewBox.classList.remove('d-none');
                    status.textContent = 'Đang tải ảnh dán lên...';
                    status.className = 'small text-muted';

                    try {
                        const formData = new FormData();
                        formData.append('file', file);

                        const response = await fetch('/SalesCSKH/UploadChatImage', {
                            method: 'POST',
                            body: formData
                        });

                        let data = {};
                        try { data = await response.json(); } catch { data = {}; }

                        if (!response.ok) throw new Error(data.message || 'Không tải ảnh được.');

                        adminSelectedImageUrl = data.imageUrl;
                        status.textContent = 'Ảnh đã dán từ bộ nhớ tạm. Nhấn Gửi để gửi kèm ảnh.';
                        status.className = 'small text-success';
                    } catch (err) {
                        adminClearImagePreview();
                        status.textContent = err.message;
                        status.className = 'small text-danger';
                    }
                    break;
                }
            }
        });

        async function closeThread() {
            if (!selectedThreadId) {
                return;
            }

            const confirmed = await openCskhConfirm({
                title: 'Đóng hội thoại?',
                html: 'Hội thoại sẽ được chuyển sang trạng thái <strong>Đã đóng</strong>.<br />Lịch sử chat vẫn được giữ để tra cứu sau này.',
                okText: '<i class="fa-solid fa-lock me-1"></i>Đóng hội thoại',
                icon: 'fa-solid fa-lock',
                warning: true
            });

            if (!confirmed) {
                return;
            }

            const status = document.getElementById('replyStatus');

            try {
                isUserBusy = true;
                status.textContent = 'Đang đóng hội thoại...';
                status.className = 'small text-muted';

                const result = await postJson('/SalesCSKH/CloseCustomerThread', {
                    threadId: selectedThreadId
                });

                selectedThreadStatus = 'Closed';

                const thread = currentThreads.find(t => sameId(t.id, selectedThreadId));

                if (thread) {
                    thread.status = 'Closed';
                    thread.unreadCount = 0;
                    thread.updatedAt = new Date().toISOString();
                }

                status.textContent = result.message || 'Đã đóng hội thoại.';
                status.className = 'small text-success';

                updateReplyState(
                    false,
                    'Hội thoại đã đóng, không thể phản hồi.',
                    'Hội thoại này đã đóng.'
                );

                lastInboxRenderKey = "";
                lastThreadRenderKey = "";

                renderInbox();

                await loadThread(selectedThreadId, false, true);
                await loadInbox(false);
            } catch (err) {
                status.textContent = err.message;
                status.className = 'small text-danger';
            } finally {
                isUserBusy = false;
            }
        }

        async function deleteThread() {
            if (!selectedThreadId) {
                return;
            }

            const confirmed = await openCskhConfirm({
                title: 'Xóa hội thoại?',
                html: 'Toàn bộ tin nhắn trong hội thoại này sẽ bị <strong>xóa khỏi hệ thống</strong>.<br />Thao tác này nên dùng cho dữ liệu test, spam hoặc hội thoại rác.',
                okText: '<i class="fa-solid fa-trash-can me-1"></i>Xóa hội thoại',
                icon: 'fa-solid fa-trash-can',
                warning: false
            });

            if (!confirmed) {
                return;
            }

            const status = document.getElementById('replyStatus');

            try {
                isUserBusy = true;
                status.textContent = 'Đang xóa hội thoại...';
                status.className = 'small text-muted';

                const result = await postJson('/SalesCSKH/DeleteCustomerThread', {
                    threadId: selectedThreadId
                });

                currentThreads = currentThreads.filter(t => !sameId(t.id, selectedThreadId));
                selectedThreadId = null;
                selectedThreadStatus = null;
                lastThreadRenderKey = "";
                lastInboxRenderKey = "";

                resetChatPane('Hội thoại đã được xóa khỏi hệ thống.');

                status.textContent = result.message || 'Đã xóa hội thoại.';
                status.className = 'small text-success';

                renderInbox();
                await loadInbox(true);
            } catch (err) {
                status.textContent = err.message;
                status.className = 'small text-danger';
            } finally {
                isUserBusy = false;
            }
        }

        document.getElementById('inboxKeyword').addEventListener('keydown', function (event) {
            if (event.key === 'Enter') {
                event.preventDefault();
                applyInboxFilter();
            }
        });

        document.getElementById('inboxStatus').addEventListener('change', applyInboxFilter);
        document.getElementById('inboxPageSize').addEventListener('change', applyInboxFilter);

        updateReplyState(
            false,
            'Vui lòng chọn hội thoại trước khi phản hồi...',
            'Ô phản hồi sẽ mở sau khi chọn hội thoại.'
        );

        loadInbox(true);

        setInterval(async () => {
            if (isUserBusy || document.hidden) {
                return;
            }

            await loadInbox(false);

            if (selectedThreadId) {
                await loadThreadIfChanged(selectedThreadId);
            }
        }, CSKH_REFRESH_INTERVAL);
    </script>
}