@model DATN64.Models.KhachHang

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Chỉnh sửa khách hàng";
    ViewData["BreadcrumbActive"] = "Chỉnh sửa khách hàng";

    var currentStatus = string.IsNullOrWhiteSpace(Model.TrangThai) ? "Hoạt động" : Model.TrangThai;
}

@functions {
    string GetRank(int points)
    {
        if (points >= 3000) return "Kim Cương";
        if (points >= 1500) return "Vàng";
        if (points >= 500) return "Bạc";
        return "Đồng";
    }

    string GetRankBadgeClass(string rank)
    {
        return rank switch
        {
            "Kim Cương" => "bg-primary text-white",
            "Vàng" => "bg-warning text-dark",
            "Bạc" => "bg-secondary text-white",
            _ => "bg-info text-dark"
        };
    }
}

<style>
    .customer-edit-hero {
        border-radius: 22px;
        padding: 22px;
        background: linear-gradient(135deg, #0ea5e9, #06b6d4);
        color: #fff;
        box-shadow: 0 14px 34px rgba(14, 165, 233, 0.25);
    }

    .edit-info-box {
        border: 1px solid #e2e8f0;
        border-radius: 18px;
        padding: 16px;
        background: #f8fafc;
    }

    .edit-info-label {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: #64748b;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .edit-info-value {
        font-size: 15px;
        font-weight: 800;
        color: #0f172a;
    }
</style>

<div class="customer-edit-hero mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-user-pen me-2"></i>
                Chỉnh sửa khách hàng
            </h3>

            <div class="opacity-75">
                Cập nhật thông tin tài khoản khách hàng #@Model.MaKhachHang
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <a href="@Url.Action("Detail", "Customer", new { id = Model.MaKhachHang })"
               class="btn btn-light rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-eye me-1"></i>
                Xem chi tiết
            </a>

            <a href="@Url.Action("Index", "Customer")"
               class="btn btn-outline-light rounded-pill px-4 fw-bold">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại
            </a>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card card-glass p-4">
            <h5 class="fw-bold text-cyan mb-4">
                <i class="fa-solid fa-pen-to-square me-2"></i>
                Thông tin có thể chỉnh sửa
            </h5>

            <form method="post" action="@Url.Action("Edit", "Customer", new { id = Model.MaKhachHang })">
                @Html.AntiForgeryToken()

                <input type="hidden" name="id" value="@Model.MaKhachHang" />

                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label text-xs fw-bold">Họ và tên</label>
                        <input type="text"
                               name="HoTen"
                               value="@Model.HoTen"
                               class="form-control"
                               required
                               placeholder="Nhập họ tên khách hàng" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-xs fw-bold">Số điện thoại</label>
                        <input type="text"
                               name="SoDienThoai"
                               value="@Model.SoDienThoai"
                               class="form-control"
                               placeholder="Nhập số điện thoại" />

                        <div class="text-xxs text-muted mt-1">
                            Không được trùng với khách hàng khác.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-xs fw-bold">Email</label>
                        <input type="email"
                               name="Email"
                               value="@Model.Email"
                               class="form-control"
                               required
                               placeholder="Nhập email" />

                        <div class="text-xxs text-muted mt-1">
                            Không được trùng với khách hàng hoặc nhân viên khác.
                        </div>
                    </div>

                    <div class="col-md-12">
                        <label class="form-label text-xs fw-bold">Địa chỉ</label>
                        <input type="text"
                               name="DiaChi"
                               value="@Model.DiaChi"
                               class="form-control"
                               placeholder="Nhập địa chỉ" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-xs fw-bold">Trạng thái tài khoản</label>
                        <select name="TrangThai" class="form-select">
                            <option value="Hoạt động" selected="@(currentStatus == "Hoạt động")">
                                Hoạt động
                            </option>

                            <option value="Ngừng hoạt động" selected="@(currentStatus == "Ngừng hoạt động")">
                                Ngừng hoạt động
                            </option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-xs fw-bold">Mã khách hàng</label>
                        <input type="text"
                               value="@Model.MaKhachHang"
                               class="form-control"
                               readonly />
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a href="@Url.Action("Detail", "Customer", new { id = Model.MaKhachHang })"
                       class="btn btn-outline-secondary rounded-pill px-4">
                        Hủy
                    </a>

                    <button type="submit" class="btn btn-info text-white rounded-pill px-4 fw-bold">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card card-glass p-4 mb-4">
            <h5 class="fw-bold text-cyan mb-4">
                <i class="fa-solid fa-circle-info me-2"></i>
                Thông tin hệ thống
            </h5>

            @{
                var rank = GetRank(Model.DiemTichLuy);
            }

            <div class="d-grid gap-3">
                <div class="edit-info-box">
                    <div class="edit-info-label">Điểm tích lũy</div>
                    <div class="edit-info-value">@Model.DiemTichLuy điểm</div>
                </div>

                <div class="edit-info-box">
                    <div class="edit-info-label">Phân hạng</div>
                    <div>
                        <span class="badge rounded-pill px-3 py-2 @GetRankBadgeClass(rank)">
                            @rank
                        </span>
                    </div>
                </div>

                <div class="edit-info-box">
                    <div class="edit-info-label">Ngày tạo tài khoản</div>
                    <div class="edit-info-value">@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
            </div>
        </div>

        <div class="card card-glass p-4">
            <h5 class="fw-bold text-warning mb-3">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>
                Lưu ý
            </h5>

            <div class="text-sm text-muted">
                <div class="mb-2">
                    Không chỉnh sửa trực tiếp điểm tích lũy tại đây.
                </div>

                <div class="mb-2">
                    Email và số điện thoại đã được database khóa không cho trùng.
                </div>

                <div>
                    Mật khẩu nên tách thành chức năng reset riêng, không sửa chung trong form này.
                </div>
            </div>
        </div>
    </div>
</div>